{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "jobs", "timeout"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "timeout": {"type": "integer", "minimum": 1, "maximum": 86400},
    "jobs": {
      "type": "object",
      "required": ["router", "clients"],
      "additionalProperties": false,
      "properties": {
        "router": {"$ref": "#/$defs/job"},
        "clients": {"$ref": "#/$defs/job"}
      }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "required": ["enabled", "times"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "times": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
        }
      }
    }
  }
}
