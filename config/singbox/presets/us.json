{
  "_preset": {
    "title": "US",
    "description": "Пользователь us и домены из us-domains идут через группу us-auto-out, их DNS — через dns-us",
    "enabled": false,
    "priority": 450,
    "requires": { "groups": ["us"] }
  },
  "dns": {
    "servers": [
      { "type": "https", "tag": "dns-us", "server": "dns.google", "detour": "us-auto-out" }
    ],
    "rules": [
      { "rule_set": "us-domains", "server": "dns-us" }
    ]
  },
  "route": {
    "rules": [
      { "auth_user": "us", "outbound": "us-auto-out" },
      { "rule_set": "us-domains", "outbound": "us-auto-out" }
    ],
    "rule_set": [
      { "type": "local", "tag": "us-domains", "format": "source", "path": "/etc/sing-box/rules/us-domains.json" }
    ]
  }
}
