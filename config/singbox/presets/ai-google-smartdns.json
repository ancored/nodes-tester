{
  "_preset": {
    "title": "ИИ: Google через SmartDNS",
    "description": "Gemini и DeepMind резолвятся через SmartDNS и идут на его прокси напрямую; всё, что попало на реальные адреса Google, → google-out, чтобы Google не увидел прямой IP. YouTube по доменам — туда же: ссылка на видео выдаётся под IP, с которого открыта страница, а кэши видео бывают и вне адресов Google. Подставьте адрес своего SmartDNS. Не включать вместе с ai-google",
    "enabled": false,
    "priority": 220
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-smart",
        "server": "smartdns.example.com",
        "domain_resolver": "bootstrap"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "google-dm",
          "google-gemini"
        ],
        "server": "dns-smart"
      }
    ]
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": "udp",
            "port": 443
          },
          {
            "rule_set": [
              "google-dm",
              "google-gemini",
              "geoip-google"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "network": "udp",
        "port": 443,
        "domain_suffix": [
          "youtube.com",
          "youtu.be",
          "youtube-nocookie.com",
          "youtubekids.com",
          "googlevideo.com",
          "ytimg.com",
          "ggpht.com"
        ],
        "action": "reject"
      },
      {
        "rule_set": "geoip-google",
        "outbound": "google-out"
      },
      {
        "domain_suffix": [
          "youtube.com",
          "youtu.be",
          "youtube-nocookie.com",
          "youtubekids.com",
          "googlevideo.com",
          "ytimg.com",
          "ggpht.com"
        ],
        "outbound": "google-out"
      },
      {
        "rule_set": [
          "google-dm",
          "google-gemini"
        ],
        "outbound": "direct-out"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "google-dm",
        "format": "binary",
        "path": "/etc/sing-box/rules/google-deepmind.srs"
      },
      {
        "type": "local",
        "tag": "google-gemini",
        "format": "binary",
        "path": "/etc/sing-box/rules/google-gemini.srs"
      },
      {
        "type": "local",
        "tag": "geoip-google",
        "format": "binary",
        "path": "/etc/sing-box/rules/geoip-google.srs"
      }
    ]
  }
}
