{
  "_preset": {
    "title": "Роутер: основа",
    "description": "sniff, перехват DNS, локальные адреса → direct-lan, тестер → nodes-tester. Домен URL-теста резолвится через bootstrap, иначе при мёртвой группе не работает и сама проверка",
    "enabled": false,
    "priority": 100
  },
  "dns": {
    "rules": [
      {
        "domain": [
          "www.gstatic.com"
        ],
        "server": "bootstrap"
      }
    ]
  },
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct-lan"
      },
      {
        "inbound": "nodes-tester-in",
        "outbound": "nodes-tester"
      }
    ]
  }
}
