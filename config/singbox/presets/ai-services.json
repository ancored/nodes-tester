{
  "_preset": {
    "title": "ИИ: Claude, OpenAI, Grok, Perplexity",
    "description": "Домены сервисов и адреса Anthropic → ai-out, их DNS — dns-ai через тот же выход. QUIC к ним и ко всем адресам Cloudflare (geoip-cloudflare, там OpenAI) запрещён: клиент откатывается на TCP, домен определяется по SNI, и поток без домена не уходит на другой выход",
    "enabled": false,
    "priority": 210
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-ai",
        "server": "1.1.1.1",
        "detour": "ai-out"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "claude",
          "openai",
          "xai",
          "perplexity"
        ],
        "server": "dns-ai"
      }
    ]
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": "udp",
            "port": 443
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "rule_set": [
                  "claude",
                  "openai",
                  "xai",
                  "perplexity"
                ]
              },
              {
                "ip_cidr": [
                  "160.79.104.0/21",
                  "2607:6bc0::/48"
                ]
              }
            ]
          }
        ],
        "action": "reject"
      },
      {
        "network": "udp",
        "port": 443,
        "rule_set": "geoip-cloudflare",
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "claude",
              "openai",
              "xai",
              "perplexity"
            ]
          },
          {
            "ip_cidr": [
              "160.79.104.0/21",
              "2607:6bc0::/48"
            ]
          }
        ],
        "outbound": "ai-out"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "claude",
        "format": "binary",
        "path": "/etc/sing-box/rules/anthropic.srs"
      },
      {
        "type": "local",
        "tag": "openai",
        "format": "binary",
        "path": "/etc/sing-box/rules/openai.srs"
      },
      {
        "type": "local",
        "tag": "xai",
        "format": "binary",
        "path": "/etc/sing-box/rules/xai.srs"
      },
      {
        "type": "local",
        "tag": "perplexity",
        "format": "binary",
        "path": "/etc/sing-box/rules/perplexity.srs"
      },
      {
        "type": "local",
        "tag": "geoip-cloudflare",
        "format": "binary",
        "path": "/etc/sing-box/rules/geoip-cloudflare.srs"
      }
    ]
  }
}
