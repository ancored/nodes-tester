{
  "_preset": {
    "title": "ИИ: Claude, OpenAI, Grok, Perplexity",
    "description": "Домены сервисов и адреса Anthropic → ai-out, их DNS — dns-ai через тот же выход. QUIC к ним и ко всему Cloudflare (там OpenAI) запрещён: клиент откатывается на TCP, домен определяется по SNI, и поток без домена не уходит на другой выход",
    "enabled": false,
    "priority": 210
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-ai",
        "server": "1.1.1.1",
        "detour": "ai-out"
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "claude",
              "openai"
            ]
          },
          {
            "domain_suffix": [
              "grok.com",
              "x.ai",
              "perplexity.ai",
              "perplexity.com",
              "pplx.ai"
            ]
          }
        ],
        "server": "dns-ai"
      }
    ]
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": "udp",
            "port": 443
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "rule_set": [
                  "claude",
                  "openai"
                ]
              },
              {
                "domain_suffix": [
                  "grok.com",
                  "x.ai",
                  "perplexity.ai",
                  "perplexity.com",
                  "pplx.ai"
                ]
              },
              {
                "ip_cidr": [
                  "160.79.104.0/21",
                  "2607:6bc0::/48"
                ]
              }
            ]
          }
        ],
        "action": "reject"
      },
      {
        "network": "udp",
        "port": 443,
        "ip_cidr": [
          "173.245.48.0/20",
          "103.21.244.0/22",
          "103.22.200.0/22",
          "103.31.4.0/22",
          "141.101.64.0/18",
          "108.162.192.0/18",
          "190.93.240.0/20",
          "188.114.96.0/20",
          "197.234.240.0/22",
          "198.41.128.0/17",
          "162.158.0.0/15",
          "104.16.0.0/13",
          "104.24.0.0/14",
          "172.64.0.0/13",
          "131.0.72.0/22",
          "2400:cb00::/32",
          "2606:4700::/32",
          "2803:f800::/32",
          "2405:b500::/32",
          "2405:8100::/32",
          "2a06:98c0::/29",
          "2c0f:f248::/32"
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "claude",
              "openai"
            ]
          },
          {
            "domain_suffix": [
              "grok.com",
              "x.ai",
              "perplexity.ai",
              "perplexity.com",
              "pplx.ai"
            ]
          },
          {
            "ip_cidr": [
              "160.79.104.0/21",
              "2607:6bc0::/48"
            ]
          }
        ],
        "outbound": "ai-out"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "claude",
        "format": "binary",
        "path": "/etc/sing-box/rules/anthropic.srs"
      },
      {
        "type": "local",
        "tag": "openai",
        "format": "binary",
        "path": "/etc/sing-box/rules/openai.srs"
      }
    ]
  }
}
