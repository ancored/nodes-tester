{
  "_preset": {
    "title": "ИИ: Google через выход",
    "description": "Gemini и DeepMind → google-out, их DNS — dns-google. Всё, что попало на адреса Google (geoip-google), тоже → google-out: приложения Gemini ходят и на общие адреса Google. QUIC к ним запрещён. YouTube по доменам — туда же: ссылка на видео выдаётся под IP, с которого открыта страница, а кэши видео бывают и вне адресов Google. Не включать вместе с ai-google-smartdns",
    "enabled": false,
    "priority": 220
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-google",
        "server": "1.1.1.1",
        "detour": "google-out"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "google-dm",
          "google-gemini"
        ],
        "server": "dns-google"
      }
    ]
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": "udp",
            "port": 443
          },
          {
            "rule_set": [
              "google-dm",
              "google-gemini",
              "geoip-google"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "network": "udp",
        "port": 443,
        "domain_suffix": [
          "youtube.com",
          "youtu.be",
          "youtube-nocookie.com",
          "youtubekids.com",
          "googlevideo.com",
          "ytimg.com",
          "ggpht.com"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "google-dm",
          "google-gemini",
          "geoip-google"
        ],
        "outbound": "google-out"
      },
      {
        "domain_suffix": [
          "youtube.com",
          "youtu.be",
          "youtube-nocookie.com",
          "youtubekids.com",
          "googlevideo.com",
          "ytimg.com",
          "ggpht.com"
        ],
        "outbound": "google-out"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "google-dm",
        "format": "binary",
        "path": "/etc/sing-box/rules/google-deepmind.srs"
      },
      {
        "type": "local",
        "tag": "google-gemini",
        "format": "binary",
        "path": "/etc/sing-box/rules/google-gemini.srs"
      },
      {
        "type": "local",
        "tag": "geoip-google",
        "format": "binary",
        "path": "/etc/sing-box/rules/geoip-google.srs"
      }
    ]
  }
}
