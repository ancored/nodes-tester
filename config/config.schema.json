{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nodes-tester/config.schema.json",
  "title": "nodes-tester config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testing_groups"
  ],
  "anyOf": [
    {
      "required": [
        "box_api"
      ]
    },
    {
      "required": [
        "clash_api"
      ]
    }
  ],
  "definitions": {
    "runParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_enabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loop": {
          "type": "boolean"
        },
        "rotation_bound": {
          "type": "boolean",
          "description": "Прогон только к сроку ротации (не непрерывно); emergency ловит монитор. Действует при loop + switching.rotation.enabled."
        },
        "pass_pause": {
          "type": "number"
        },
        "switch_delay": {
          "type": "number"
        },
        "min_host_gap": {
          "type": "number",
          "minimum": 0,
          "description": "Анти-ТСПУ: минимум секунд между обращениями к одному хосту с разным портом/протоколом. Тот же порт/протокол ожидания не вызывает."
        },
        "rounds": {
          "type": "integer"
        },
        "request_timeout": {
          "type": "number"
        },
        "restore_selection": {
          "type": "boolean"
        },
        "heavy_candidates": {
          "type": "integer",
          "minimum": 0,
          "description": "Двухуровневое тестирование: > 0 включает тяжёлый 50МБ download-veto перед ротацией региона: проверяется весь пул ротации (switching.rotation.top_k), место vetoed-ноды занимает следующая. 0 = выкл."
        },
        "required_tests": {
          "type": "array",
          "description": "обязательные тесты группы (отдельная фаза): активной может быть только нода со свежим успешным результатом, иначе группа на failsafe",
          "items": {
            "enum": [
              "gemini"
            ]
          }
        },
        "heavy_veto_hours": {
          "type": "number",
          "minimum": 0,
          "description": "Сколько часов действует heavy-veto, пока ноду не пере-проверят тяжёлым download."
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "box_api": {
      "type": "object",
      "description": "API-сервис sing-box 1.14 (services[].type = \"api\")",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        },
        "timeout": {
          "type": "number"
        }
      }
    },
    "clash_api": {
      "type": "object",
      "description": "Устарело: до 0.3.0. Читается как box_api (base_url → url)",
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        },
        "timeout": {
          "type": "number"
        }
      }
    },
    "testing_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "connection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "socks5"
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "username": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "region_groups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recognition": {
          "enum": [
            "parse",
            "manually"
          ]
        },
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tag": {
                "type": "string"
              },
              "nodes_list": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/runParams"
        },
        "testing_groups_specifics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "testing_group_tag": {
                "type": "string"
              },
              "default_overrides": {
                "$ref": "#/definitions/runParams"
              }
            }
          }
        },
        "node_groups_specifics": {
          "type": "array",
          "description": "переопределения тестов по группам нод ({group}-auto-out); у ноды в нескольких группах наборы тестов объединяются",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string"
              },
              "default_overrides": {
                "$ref": "#/definitions/runParams"
              }
            }
          }
        },
        "region_groups_specifics": {
          "description": "устарело: то же, что node_groups_specifics (region_group_tag = имя группы)",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "region_group_tag": {
                "type": "string"
              },
              "default_overrides": {
                "$ref": "#/definitions/runParams"
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "console": {
          "type": "boolean"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "alpha": {
          "type": "number"
        },
        "flap_lambda": {
          "type": "number"
        },
        "avail_floor": {
          "type": "number"
        },
        "avail_full": {
          "type": "number"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "switching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "quality_margin": {
          "type": "number"
        },
        "confirm_cycles": {
          "type": "integer"
        },
        "comfort_floor": {
          "type": "number"
        },
        "cooldown": {
          "type": "number"
        },
        "exclude_test_groups": {
          "type": "boolean"
        },
        "freeze_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "number"
            },
            "jitter": {
              "type": "number"
            },
            "align": {
              "type": "boolean",
              "description": "Общие сроки ротации для всех групп (сетка с шагом interval, jitter общий на слот): один прогон тестера обслуживает все группы. false — у каждой группы свой срок."
            },
            "min_dwell": {
              "type": "number"
            },
            "top_k": {
              "type": "integer"
            },
            "min_score": {
              "type": "number"
            },
            "avoid_recent": {
              "type": "integer"
            },
            "load_balance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "window_hours": {
                  "type": "number"
                },
                "provider_strength": {
                  "type": "number"
                },
                "country_strength": {
                  "type": "number"
                },
                "protocol_strength": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "number"
        },
        "reassert_drift": {
          "type": "boolean"
        },
        "silence_window": {
          "type": "number"
        },
        "silence_floor_mb": {
          "type": "number"
        },
        "probe_bytes": {
          "type": "integer"
        },
        "probe_min_mbps": {
          "type": "number"
        },
        "probe_timeout": {
          "type": "number"
        },
        "probe_url": {
          "type": "string"
        },
        "fails": {
          "type": "integer"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "db_file": {
          "type": "string"
        },
        "nodes_file": {
          "type": "string"
        },
        "retention_days": {
          "type": "integer"
        },
        "store_results": {
          "type": "boolean"
        },
        "traffic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "poll_interval": {
              "type": "number"
            },
            "flush_interval": {
              "type": "number"
            }
          }
        }
      }
    },
    "cooldown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "base_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "УСТАРЕЛО, игнорируется (была временная модель паузы). Пауза теперь считается в прогонах."
        },
        "max_skip": {
          "type": "integer",
          "minimum": 1,
          "description": "Потолок паузы в прогонах: после n-го подряд провала gate нода пропускает 2^(n-1) прогонов; когда пропуск дорастает до max_skip — карантин на garbage_hours."
        },
        "garbage_hours": {
          "type": "number",
          "minimum": 0,
          "description": "Длительность карантина в часах (после неё — одна проба; провал → снова карантин). Переживает рестарт."
        },
        "low_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Карантин слабых нод: рейтинг ниже порога → карантин на garbage_hours (кроме активных и новых, < 3 замеров). 0 — выключено."
        }
      }
    },
    "singbox_control": {
      "type": "object",
      "additionalProperties": false,
      "description": "Остановка/запуск sing-box из админки и управление службой killswitch роутера (только OpenWrt).",
      "properties": {
        "enabled": { "type": "boolean" },
        "init": { "type": "string", "description": "init-скрипт sing-box." },
        "stop_flag": { "type": "string", "description": "Флаг «остановлен из админки» (tmpfs); пока он есть, apply-nodes.sh не применяет конфиг." },
        "killswitch_init": { "type": "string", "description": "init-скрипт службы killswitch роутера." },
        "killswitch_table": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Таблица inet, которую загружает служба killswitch (для показа состояния)." },
        "interval": { "type": "number", "exclusiveMinimum": 0 },
        "down_alert": { "type": "number", "minimum": 0 }
      }
    },
    "ip_info": {
      "type": "object",
      "additionalProperties": false,
      "description": "Тип выходного IP нод (ASN, дата-центр, мобильная сеть, прокси) по exit_ip из connectivity; запрос с роутера, кэш ttl_days.",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "description": "Пакетный эндпоинт ip-api.com (бесплатно — только http)." },
        "via_tester": { "type": "boolean", "description": "Запрос через SOCKS тестера (на лучшей здоровой ноде): DNS-фильтры часто блокируют ip-api.com. При неудаче — напрямую." },
        "ttl_days": { "type": "number", "minimum": 0 },
        "timeout": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "description": "Уведомления в Telegram и/или webhook. Без получателей и при enabled=false не отправляется ничего.",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "description": "Подпись роутера в начале сообщения." },
        "telegram": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "token": { "type": "string", "description": "Токен бота от @BotFather." },
            "chat_id": { "type": ["string", "integer"], "description": "Получатель: свой id или id группы." }
          }
        },
        "webhook": {
          "type": "object", "additionalProperties": false,
          "properties": { "url": { "type": "string", "description": "POST JSON {event, text, ts}." } }
        },
        "proxy": { "type": "string", "description": "Прокси для отправки, напр. socks5h://host:port; пусто — напрямую." },
        "events": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["switch", "failsafe", "rollback", "pipeline", "subscription", "expiry", "singbox"] }
        },
        "switch_reasons": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["init", "rotation", "quality", "emergency", "emergency-stuck", "manual"] },
          "description": "О каких переключениях нод сообщать (событие switch)."
        },
        "expiry_days": { "type": "number", "minimum": 0 },
        "dedupe_minutes": { "type": "number", "minimum": 0 },
        "max_per_hour": { "type": "integer", "minimum": 1 },
        "timeout": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "description": "Веб-админка/дашборд. enabled — встраивать ли сервер в процесс тестера (тогда доступны write/control-эндпоинты). Отдельный `python -m dashboard` работает независимо (read-only).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Встраивать HTTP-сервер админки в процесс тестера (доступ к живым Runner/Switcher для управления)."
        },
        "host": {
          "type": "string",
          "description": "Адрес привязки сокета. Держите LAN-адрес; не выставляйте наружу."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "description": "Период авто-обновления UI, сек."
        },
        "token": {
          "type": "string",
          "description": "Shared-токен для write/control (заголовок X-Admin-Token). Пусто = write/control отключены."
        },
        "read_open": {
          "type": "boolean",
          "description": "Разрешить просмотр (read-эндпоинты) без токена."
        },
        "groups_file": {
          "type": "string",
          "description": "Файл рецепта сборки для редактора. Относительный путь от config.json; пусто = groups_params.json рядом с dashboard.providers_file."
        },
        "providers_file": {
          "type": "string",
          "description": "Подписки для редактора админки — тот же файл, что читает nodes_fetch (напр. /root/nodes-data/config-main/providers.json). Относительный путь — от папки config.json; пусто = providers.json рядом с config.json."
        }
      }
    }
  }
}
