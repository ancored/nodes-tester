{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ancored/nodes-tester/config.schema.json",
  "title": "nodes-tester config.json",
  "description": "Единый конфиг nodes-tester. Описание полей — docs/CONFIG.md.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
      "description": "Длительность: \"250ms\", \"5s\", \"1h30m\", \"30d\"."
    },
    "groupCheck": {
      "type": "object",
      "additionalProperties": false,
      "description": "Проверка в группе: ttl — свой срок годности; у country и ip_type — условия.",
      "properties": {
        "ttl": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
          "description": "Длительность: \"250ms\", \"5s\", \"1h30m\", \"30d\"."
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "country: допустимые страны, ISO-коды."
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "country: допустимые регионы."
        },
        "exclude_countries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "country: недопустимые страны."
        },
        "exclude_regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "country: недопустимые регионы."
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "residential",
              "mobile",
              "hosting",
              "proxy"
            ]
          },
          "description": "ip_type: допустимые типы IP."
        }
      }
    },
    "groupChecks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "$ref": "#/definitions/groupCheck"
        },
        "ip_type": {
          "$ref": "#/definitions/groupCheck"
        },
        "geo_consistent": {
          "$ref": "#/definitions/groupCheck"
        },
        "gemini": {
          "$ref": "#/definitions/groupCheck"
        },
        "openai": {
          "$ref": "#/definitions/groupCheck"
        },
        "anthropic": {
          "$ref": "#/definitions/groupCheck"
        },
        "heavy": {
          "$ref": "#/definitions/groupCheck"
        },
        "whitelist": {
          "$ref": "#/definitions/groupCheck"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Адрес API-сервиса sing-box.",
          "default": "http://127.0.0.1:9090"
        },
        "secret": {
          "type": "string",
          "description": "Секрет API-сервиса sing-box."
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
          "description": "Тайм-аут запроса.",
          "default": "5s"
        }
      },
      "description": "API-сервис sing-box (services[].type = api)."
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string",
            "description": "Имя провайдера: входит в теги нод, уникально."
          },
          "enabled": {
            "type": "boolean",
            "description": "Использовать подписку.",
            "default": true
          },
          "branch": {
            "enum": [
              "router",
              "clients",
              "both"
            ],
            "default": "router",
            "description": "Ветвь сборки: router — nodes.json роутера, clients — whnodes.json клиентов, both — обе."
          },
          "type": {
            "enum": [
              "url",
              "file",
              "folder",
              "inline"
            ],
            "default": "url",
            "description": "Источник: url (или happ://crypt…), file, folder (каталог AWG), inline (свои outbound-ы)."
          },
          "url": {
            "type": "string",
            "description": "URL подписки, share-ссылка или happ://crypt…"
          },
          "file": {
            "type": "string",
            "description": "Локальный файл подписки (относительно config.json)."
          },
          "path": {
            "type": "string",
            "description": "folder: каталог с конфигами (относительно config.json)."
          },
          "format": {
            "type": "string",
            "description": "folder: формат файлов, например awg."
          },
          "ext": {
            "type": "string",
            "description": "folder: расширение файлов, например .conf."
          },
          "user_agent": {
            "type": "string",
            "description": "User-Agent HTTP-загрузки: пусто — Safari, curl, clashmeta или свой."
          },
          "happ_headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "happ://: заголовки поверх набора Happ по умолчанию."
          },
          "send_device": {
            "type": "boolean",
            "description": "url: отправлять HWID и описание устройства.",
            "default": false
          },
          "exclude_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Не брать ноды, в имени которых есть подстрока."
          },
          "outbounds": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "inline: outbound-ы sing-box."
          }
        },
        "required": [
          "tag"
        ]
      },
      "description": "Источники нод."
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectivity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "description": "Сервис определения выходного IP и страны (адрес и разбор ответа встроены).",
              "default": "cloudflare"
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут запроса; по умолчанию tester.request_timeout.",
              "default": "10s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля теста для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Соединение через ноду; заодно измеряет страну выхода."
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "Адрес замера TTFB."
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут запроса; по умолчанию tester.request_timeout.",
              "default": "10s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля теста для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Задержка до первого байта."
        },
        "jitter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "Адрес замера."
            },
            "samples": {
              "type": "integer",
              "description": "Число замеров.",
              "default": 5,
              "minimum": 1
            },
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Пауза между замерами.",
              "default": "200ms"
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут запроса; по умолчанию tester.request_timeout.",
              "default": "10s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля теста для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Разброс задержки и потери."
        },
        "download": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "Адрес закачки."
            },
            "duration": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Предел длительности закачки.",
              "default": "20s"
            },
            "window_mb": {
              "type": "number",
              "description": "Окно для оценки троттлинга, МБ.",
              "default": 2,
              "minimum": 0
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут запроса; по умолчанию tester.request_timeout.",
              "default": "10s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля теста для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Скорость и троттлинг."
        },
        "reachability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Адреса проверки доступности."
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут запроса; по умолчанию tester.request_timeout.",
              "default": "10s"
            },
            "workers": {
              "type": "integer",
              "description": "Параллельных запросов.",
              "default": 8,
              "minimum": 1
            },
            "for_region": {
              "type": "object",
              "description": "Поля теста для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Доступность набора сайтов."
        },
        "for_region": {
          "type": "object",
          "description": "Поля тестов для нод с выходом в регионе: регион → тест → поля.",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "description": "Замеры рейтинга при каждом проходе ноды."
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "24h"
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Страна выхода по замеру соединения."
        },
        "ip_type": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности сведений.",
              "default": "24h"
            },
            "url": {
              "type": "string",
              "description": "Адрес batch-запроса ip-api.",
              "default": "http://ip-api.com/batch"
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут запроса.",
              "default": "10s"
            },
            "via_tester": {
              "type": "boolean",
              "description": "Запрашивать через SOCKS тестера на лучшей ноде, иначе напрямую.",
              "default": true
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Тип выходного IP по ip-api: домашний, мобильный, дата-центр, прокси."
        },
        "geo_consistent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "24h"
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Страна IP по базе совпадает с измеренной."
        },
        "gemini": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "24h"
            },
            "attempts": {
              "type": "integer",
              "description": "Попыток.",
              "default": 3,
              "minimum": 1
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут попытки.",
              "default": "20s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Доступ к Google AI (Gemini)."
        },
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "24h"
            },
            "attempts": {
              "type": "integer",
              "description": "Попыток.",
              "default": 3,
              "minimum": 1
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут попытки.",
              "default": "15s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Доступ к OpenAI."
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "24h"
            },
            "attempts": {
              "type": "integer",
              "description": "Попыток.",
              "default": 3,
              "minimum": 1
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Тайм-аут попытки.",
              "default": "15s"
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Доступ к Claude."
        },
        "heavy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "6h"
            },
            "url": {
              "type": "string",
              "description": "Адрес тяжёлой закачки."
            },
            "duration": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Предел длительности.",
              "default": "30s"
            },
            "window_mb": {
              "type": "number",
              "description": "Окно оценки, МБ.",
              "default": 2,
              "minimum": 0
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Тяжёлая закачка кандидатов резерва."
        },
        "whitelist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
              "description": "Срок годности вердикта.",
              "default": "24h"
            },
            "cidr": {
              "type": "string",
              "description": "Набор адресов белого списка.",
              "default": "russia-mobile-whitelist-cidr.srs"
            },
            "domains": {
              "type": "string",
              "description": "Набор доменов белого списка.",
              "default": "russia-mobile-whitelist-domains.srs"
            },
            "for_region": {
              "type": "object",
              "description": "Поля проверки для нод с выходом в регионе: регион → поля.",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "description": "Вхождение сервера ноды в белые списки (пока не выполняется)."
        }
      },
      "description": "Проверки с вердиктом и сроком годности; значения по умолчанию для групп."
    },
    "regions": {
      "type": "object",
      "description": "Регион → список стран. Встроенные eu, us, ru, other можно переопределить.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z]{2}$"
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Группы sing-box {tag}-auto-out и их политика. По умолчанию — одна группа all.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string",
            "description": "Тег группы: латиница в нижнем регистре, цифры, _.",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "strict": {
            "type": "boolean",
            "description": "Без кандидата — block-out, а не failsafe-out.",
            "default": false
          },
          "direct_fallback": {
            "type": "boolean",
            "description": "Добавить direct-out; у строгой группы — запасной выход вместо block-out.",
            "default": false
          },
          "in_global": {
            "type": "boolean",
            "description": "Входит в global-auto-out.",
            "default": true
          },
          "reserve": {
            "type": "integer",
            "description": "Кандидатов в резерве (по умолчанию selection.reserve).",
            "minimum": 0,
            "maximum": 20
          },
          "require": {
            "$ref": "#/definitions/groupChecks",
            "description": "Обязательные проверки: без свежего успеха нода не кандидат."
          },
          "prefer": {
            "$ref": "#/definitions/groupChecks",
            "description": "Желательные проверки: успехи поднимают ноду в очереди."
          }
        },
        "required": [
          "tag"
        ]
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "type": "number",
          "description": "Сглаживание EWMA рейтинга.",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1
        },
        "flap_lambda": {
          "type": "number",
          "description": "Штраф за флапы.",
          "default": 0.5,
          "minimum": 0
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor": {
              "type": "number",
              "description": "Доступность, ниже которой рейтинг 0.",
              "default": 0.7,
              "minimum": 0,
              "maximum": 1
            },
            "full": {
              "type": "number",
              "description": "Доступность полного рейтинга.",
              "default": 0.9,
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latency": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "good": {
                  "type": "string",
                  "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
                  "description": "Длительность: \"250ms\", \"5s\", \"1h30m\", \"30d\"."
                },
                "bad": {
                  "type": "string",
                  "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
