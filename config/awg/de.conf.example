# Шаблон AmneziaWG-конфига: скопируйте в de.conf (имя файла = код страны), вставьте свои ключи.
[Interface]
Address = 10.8.0.2/32
DNS = 1.1.1.1
PrivateKey = YOUR-PRIVATE-KEY
Jc = 4
Jmin = 10
Jmax = 80
S1 = 0
S2 = 0
H1 = 1
H2 = 2
H3 = 3
H4 = 4
[Peer]
PublicKey = SERVER-PUBLIC-KEY
PresharedKey = YOUR-PRESHARED-KEY
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint = 203.0.113.1:51820
PersistentKeepalive = 25
