{
  "$schema": "config.schema.json",
  "api": {
    "url": "http://127.0.0.1:9090",
    "secret": "YOUR-SING-BOX-API-SECRET"
  },
  "subscriptions": [
    { "tag": "PROV-A", "url": "https://sub.example.com/sub/YOUR-SUBSCRIPTION-TOKEN", "user_agent": "curl" },
    { "tag": "PROV-HAPP", "url": "happ://crypt5/YOUR-ENCRYPTED-HAPP-LINK" },
    { "tag": "AWG", "type": "folder", "path": "awg", "format": "awg", "ext": ".conf" },
    {
      "tag": "my",
      "type": "inline",
      "enabled": false,
      "outbounds": [
        {
          "tag": "Custom-NL",
          "type": "vless",
          "server": "203.0.113.10",
          "server_port": 443,
          "uuid": "00000000-0000-4000-8000-000000000000",
          "flow": "xtls-rprx-vision",
          "tls": {
            "enabled": true,
            "server_name": "www.example.com",
            "reality": { "enabled": true, "public_key": "YOUR-REALITY-PUBLIC-KEY", "short_id": "0123abcd" },
            "utls": { "enabled": true, "fingerprint": "chrome" }
          }
        }
      ]
    }
  ],
  "groups": [
    { "tag": "all" }
  ],
  "pipeline": {
    "router": {
      "enabled": false,
      "at": ["03:00"],
      "exclude_types": ["shadowsocksr"],
      "selector": { "interrupt_exist_connections": false },
      "urltest": { "interval": "5m", "tolerance": 100, "idle_timeout": "5m", "interrupt_exist_connections": true }
    },
    "clients": {
      "enabled": false,
      "exclude_types": ["shadowsocksr"],
      "exclude_protocols": ["xhttp", "wg"]
    }
  },
  "admin": {
    "enabled": false,
    "token": ""
  }
}
