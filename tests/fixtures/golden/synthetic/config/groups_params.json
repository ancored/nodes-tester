{
  "selector": {
    "interrupt_exist_connections": true
  },
  "urltest": {
    "interval": "5m",
    "tolerance": 100,
    "idle_timeout": "5m",
    "interrupt_exist_connections": true
  },
  "emit": {
    "nodes_tester": true,
    "global_failsafe": false
  },
  "raw_user_nodes": false,
  "filters": {
    "exclude_types": [
      "shadowsocksr"
    ],
    "exclude_countries": [
      "ru"
    ]
  },
  "rename": {
    "labels": {
      "AI": [
        "ChatGPT",
        "OpenAI"
      ],
      "Media": [
        "Netflix"
      ]
    },
    "domain_resolver_tag": "bootstrap"
  }
}
