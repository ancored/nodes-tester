{
  "subscriptions": [
    {
      "url": "https://sub.example/alpha",
      "tag": "ALPHA",
      "user_agent": "curl",
      "branch": "clients"
    },
    {
      "url": "https://sub.example/beta.yaml",
      "tag": "BETA",
      "branch": "clients"
    },
    {
      "url": "https://sub.example/gamma-down",
      "tag": "GAMMA",
      "branch": "clients"
    },
    {
      "url": "https://sub.example/disabled",
      "tag": "OFF",
      "enabled": false,
      "branch": "clients"
    },
    {
      "type": "folder",
      "path": "awg",
      "format": "awg",
      "ext": ".conf",
      "tag": "AWG",
      "branch": "clients"
    },
    {
      "tag": "Custom",
      "type": "inline",
      "outbounds": [
        {
          "type": "vless",
          "tag": "Custom-NL",
          "server": "10.0.3.1",
          "server_port": 443,
          "uuid": "11111111-1111-4111-8111-111111111111",
          "flow": "xtls-rprx-vision",
          "tls": {
            "enabled": true,
            "server_name": "www.example.com",
            "utls": {
              "enabled": true,
              "fingerprint": "chrome"
            },
            "reality": {
              "enabled": true,
              "public_key": "Zm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyMDA",
              "short_id": "aa"
            }
          }
        }
      ],
      "branch": "clients"
    }
  ],
  "pipeline": {
    "clients": {
      "exclude_types": [
        "shadowsocksr"
      ],
      "exclude_protocols": [
        "xhttp",
        "wg"
      ],
      "domain_resolver": "dns-whitelist",
      "selector": {
        "interrupt_exist_connections": true
      },
      "urltest": {
        "interval": "5m",
        "tolerance": 100,
        "idle_timeout": "5m",
        "interrupt_exist_connections": true
      }
    }
  }
}
