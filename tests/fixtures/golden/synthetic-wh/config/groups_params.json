{
  "selector": {
    "interrupt_exist_connections": true
  },
  "urltest": {
    "interval": "5m",
    "tolerance": 100,
    "idle_timeout": "5m",
    "interrupt_exist_connections": true
  },
  "emit": {
    "nodes_tester": false,
    "global_failsafe": true
  },
  "raw_user_nodes": true,
  "filters": {
    "exclude_types": [
      "shadowsocksr"
    ],
    "exclude_protocols": [
      "xhttp",
      "wg"
    ]
  },
  "rename": {
    "labels": {
      "AI": [
        "ChatGPT",
        "OpenAI"
      ],
      "Media": [
        "Netflix"
      ]
    },
    "domain_resolver_tag": "dns-whitelist"
  }
}
