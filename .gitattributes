# Shell-скрипты исполняются на роутере (busybox sh) — только LF
*.sh text eol=lf

# OpenWrt-пакет: Makefile, init-скрипты, UCI — тоже только LF
openwrt/** text eol=lf

# Роутерные скрипты (в т.ч. merge-configs.py) — тоже только LF
scripts/router/** text eol=lf

# PowerShell-скрипты для Windows — CRLF
*.ps1 text eol=crlf

# Документация и исходники админки — только LF: справка разбирается построчно, ключ схемы mermaid —
# хэш её текста (с CRLF схемы не находятся, SVG не совпадают с собранными)
*.md  text eol=lf
*.js  text eol=lf
*.mjs text eol=lf
*.vue text eol=lf
*.svg text eol=lf
*.html text eol=lf
