# Shell-скрипты исполняются на роутере (busybox sh) — только LF
*.sh text eol=lf

# OpenWrt-пакет: Makefile, init-скрипты, UCI — тоже только LF
openwrt/** text eol=lf

# Роутерные скрипты (в т.ч. merge-configs.py) — тоже только LF
scripts/router/** text eol=lf

# PowerShell-скрипты для Windows — CRLF
*.ps1 text eol=crlf
