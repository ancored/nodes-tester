config nodes-tester 'main'
	# рабочие конфиги: config.json, config-main/, config-wh/, clients.list
	option config_dir '/etc/nodes-tester'
	# stats.db, raw подписок, кандидаты конфига — должен быть на постоянном носителе
	# (не /tmp и не /var: на OpenWrt они в RAM)
	option data_dir '/opt/nodes-tester'

config service 'tester'
	# тестер; веб-админка встроена в него (блок dashboard в config.json)
	option enabled '0'
