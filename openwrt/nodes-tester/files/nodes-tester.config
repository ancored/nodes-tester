config nodes-tester 'main'
	# рабочие конфиги: config.json (подписки, группы, клиенты, тестер, конвейер), singbox/
	option config_dir '/etc/nodes-tester'
	# nodes.json, whnodes.json, stats.db, raw подписок — должен быть на постоянном носителе
	# (не /tmp и не /var: на OpenWrt они в RAM)
	option data_dir '/opt/nodes-tester'

config service 'tester'
	# тестер; веб-админка встроена в него (раздел admin в config.json)
	option enabled '0'
