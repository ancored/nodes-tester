#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

APP_DIR=/usr/lib/nodes-tester

start_service() {
	config_load nodes-tester
	local enabled config_dir data_dir
	config_get_bool enabled tester enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get config_dir main config_dir /etc/nodes-tester
	config_get data_dir main data_dir /opt/nodes-tester

	[ -f "$config_dir/config.json" ] || {
		logger -t nodes-tester "нет $config_dir/config.json"
		return 1
	}
	mkdir -p "$data_dir"

	procd_open_instance
	# относительные пути config.json (storage.db_file) отсчитываются от data_dir
	procd_set_param command /bin/sh -c "cd '$data_dir' && exec /usr/bin/python3 -u -m nodes_tester --config '$config_dir/config.json'"
	procd_set_param env PYTHONPATH="$APP_DIR" PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nodes-tester
}
